BOT_TOKEN=
ADMIN_ID=
# Numeric channel ID (-100...) or @channel_username
CHANNEL_ID=
# Docker Compose connects to service "db"; for a local process use localhost.
DATABASE_URL=postgresql://ranhigs:change-me@localhost:5432/ranhigs
POSTGRES_DB=ranhigs
POSTGRES_USER=ranhigs
POSTGRES_PASSWORD=change-me
AUTO_PUBLISH=true
MIN_TEXT_LENGTH=10
MAX_TEXT_LENGTH=3000
RATE_LIMIT_COUNT=3
RATE_LIMIT_WINDOW_SECONDS=600
MIN_SUBMISSION_INTERVAL_SECONDS=15
DUPLICATE_WINDOW_SECONDS=86400
REJECTED_RETENTION_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=60
MODERATION_RULES_PATH=./moderation_rules.json
LOG_LEVEL=INFO
